{
  "manifest_version": 3,
  "name": "Wealth-Wait AI",
  "version": "1.1",
  "description": "An AI-powered financial speed bump to reduce impulse spending.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.ebay.com/*",
        "*://*.walmart.com/*",
        "*://*.target.com/*",
        "*://*.bestbuy.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}